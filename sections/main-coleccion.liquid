{%- comment -%}
  Página de colección.

  Cabecera con la foto de la colección, filtros y orden nativos de Shopify, y
  la misma rejilla del catálogo.

  Todo funciona sin JavaScript: el orden y los filtros son formularios GET, así
  que la URL siempre describe lo que se está viendo y se puede compartir o
  guardar. El JS sólo cambia el trozo de la página que hace falta en vez de
  recargarla entera, y para eso necesita que la sección se pueda pedir suelta
  (Section Rendering API) — por eso el `id` del contenedor.
{%- endcomment -%}

{%- liquid
  comment
    La cabecera «con foto» pone el texto en claro porque va sobre la imagen.
    Si la coleccion NO tiene imagen, ese blanco cae sobre el fondo palido de la
    pagina y el titulo casi no se lee. Sin foto se cae a la cabecera simple.
  endcomment
  assign cabecera = section.settings.cabecera
  if cabecera == 'foto'
    unless collection.image
      assign cabecera = 'simple'
    endunless
  endif

  assign cols = section.settings.columnas | default: 4
  assign cols_movil = section.settings.columnas_movil | default: 2
  assign por_pagina = section.settings.por_pagina | default: 24
-%}

<section class="coleccion" id="coleccion-{{ section.id }}"
  style="--cols: {{ cols }}; --cols-movil: {{ cols_movil }};"
  data-seccion-id="{{ section.id }}">

  {%- comment -%} ---------- cabecera ---------- {%- endcomment -%}
  <header class="col-cab col-cab--{{ cabecera }}">
    {%- if cabecera == 'foto' -%}
      <div class="col-cab__foto">
        <img src="{{ collection.image | image_url: width: 2000 }}"
          srcset="{{ collection.image | image_url: width: 800 }} 800w,
                  {{ collection.image | image_url: width: 1400 }} 1400w,
                  {{ collection.image | image_url: width: 2000 }} 2000w"
          sizes="100vw" alt="{{ collection.image.alt | escape }}"
          width="{{ collection.image.width }}" height="{{ collection.image.height }}"
          loading="eager" fetchpriority="high">
        <span class="col-cab__velo"></span>
      </div>
    {%- endif -%}

    <div class="col-cab__txt">
      {%- if section.settings.migas -%}
        <nav class="migas" aria-label="{{ 'general.migas' | t }}">
          <a href="{{ routes.root_url }}">{{ 'general.inicio' | t }}</a>
          <span aria-hidden="true">/</span>
          <a href="{{ routes.collections_url }}">{{ 'colecciones.todas' | t }}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{{ collection.title }}</span>
        </nav>
      {%- endif -%}

      <h1 class="h2">{{ collection.title }}</h1>

      {%- if collection.description != blank -%}
        <div class="col-cab__desc rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </header>

  {%- comment -%}
    De aquí para abajo es lo que se vuelve a pedir al filtrar. Va en su propio
    contenedor para poder cambiarlo entero sin tocar la cabecera.
  {%- endcomment -%}
  <div data-facetas-resultados>
    {% render 'facetas',
      filtros: collection.filters,
      url: collection.url,
      orden: collection.sort_by,
      orden_por_defecto: collection.default_sort_by,
      opciones_orden: collection.sort_options,
      total: collection.products_count,
      id_seccion: section.id %}

    {%- paginate collection.products by por_pagina -%}
      {%- if collection.products.size > 0 -%}
        <div class="shelf" data-facetas-rejilla>
          {%- for producto in collection.products -%}
            {%- comment -%}
              Las cuatro primeras se ven sin bajar: su foto va sin diferir. Una
              página de colección es la puerta de entrada desde el buscador, y
              ahí la primera impresión la da la foto, no el texto.
            {%- endcomment -%}
            {%- liquid
              assign arriba = false
              if forloop.index <= 4
                assign arriba = true
              endif
            -%}
            {% render 'card-fragancia', producto: producto, ratio: section.settings.ratio, indice: forloop.index, prioridad: arriba %}
          {%- endfor -%}
        </div>

        {% render 'paginacion', paginate: paginate %}
      {%- else -%}
        <div class="vacio-pagina">
          <p class="vacio-pagina__t">
            {%- if collection.filters.size > 0 -%}
              {{ 'colecciones.sin_resultados_filtro' | t }}
            {%- else -%}
              {{ 'colecciones.sin_productos' | t }}
            {%- endif -%}
          </p>
          <a class="btn btn--ink" href="{{ collection.url }}" data-facetas-enlace>
            {{ 'colecciones.limpiar' | t }}
          </a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "t:secciones.coleccion.nombre",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "cabecera",
      "label": "t:secciones.coleccion.cabecera",
      "default": "foto",
      "options": [
        { "value": "simple", "label": "t:secciones.coleccion.cabeceras.simple" },
        { "value": "foto", "label": "t:secciones.coleccion.cabeceras.foto" },
        { "value": "centrada", "label": "t:secciones.coleccion.cabeceras.centrada" }
      ]
    },
    { "type": "checkbox", "id": "migas", "label": "t:secciones.coleccion.migas", "default": true },
    { "type": "header", "content": "t:comun.rejilla" },
    { "type": "range", "id": "columnas", "min": 2, "max": 6, "step": 1, "label": "t:comun.columnas", "default": 4 },
    { "type": "range", "id": "columnas_movil", "min": 1, "max": 3, "step": 1, "label": "t:comun.columnas_movil", "default": 2 },
    { "type": "range", "id": "por_pagina", "min": 8, "max": 48, "step": 4, "label": "t:secciones.coleccion.por_pagina", "default": 24 },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:comun.ratio",
      "default": "1/1",
      "options": [
        { "value": "1/1", "label": "t:comun.ratios.cuadrada" },
        { "value": "4/5", "label": "t:comun.ratios.vertical" },
        { "value": "3/4", "label": "t:comun.ratios.retrato" },
        { "value": "5/4", "label": "t:comun.ratios.horizontal" }
      ]
    }
  ]
}
{% endschema %}
