{%- comment -%}
  Buscador.

  El formulario es un GET normal: la búsqueda queda en la URL y se puede
  compartir o guardar. `type=product` porque en esta tienda lo que se busca son
  fragancias, no artículos del blog.

  Los filtros son los mismos que los de colección: `search.filters` tiene la
  misma forma que `collection.filters`, así que se reutiliza el snippet en vez
  de mantener dos versiones que acaban divergiendo.
{%- endcomment -%}

{%- liquid
  assign cols = section.settings.columnas | default: 4
  assign cols_movil = section.settings.columnas_movil | default: 2
-%}

<section class="busqueda" id="busqueda-{{ section.id }}"
  style="--cols: {{ cols }}; --cols-movil: {{ cols_movil }};"
  data-seccion-id="{{ section.id }}">

  <header class="sec-head sec-head--center">
    <p class="eyebrow"><span class="dot" aria-hidden="true"></span> {{ 'general.buscar.titulo' | t }}</p>
    <h1 class="h2">{{ 'general.buscar.encabezado' | t }}</h1>
  </header>

  <form class="buscador" action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="q">{{ 'general.buscar.etiqueta' | t }}</label>
    {% render 'icono', tipo: 'buscar', tam: 20 %}
    <input id="q" type="search" name="q" value="{{ search.terms | escape }}"
      placeholder="{{ 'general.buscar.placeholder' | t }}" autocomplete="off">
    <input type="hidden" name="type" value="product">
    <button class="btn btn--ink" type="submit">{{ 'general.buscar.boton' | t }}</button>
  </form>

  {%- if search.performed -%}
    <div data-facetas-resultados>
      {%- if search.results_count > 0 -%}
        {% render 'facetas',
          filtros: search.filters,
          url: routes.search_url,
          terminos: search.terms,
          orden: search.sort_by,
          orden_por_defecto: search.default_sort_by,
          opciones_orden: search.sort_options,
          total: search.results_count,
          id_seccion: section.id %}
      {%- endif -%}

      {%- paginate search.results by section.settings.por_pagina -%}
        {%- if search.results_count > 0 -%}
          <div class="shelf" data-facetas-rejilla>
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'card-fragancia', producto: item, ratio: section.settings.ratio %}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {% render 'paginacion', paginate: paginate %}
        {%- else -%}
          <div class="vacio-pagina">
            <p class="vacio-pagina__t">{{ 'general.buscar.sin_resultados' | t: terms: search.terms }}</p>
            <button class="btn btn--ink" type="button" data-chat>
              {% render 'icono', tipo: 'chat', tam: 16 %}
              {{ 'general.buscar.pregunta' | t }}
            </button>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:secciones.busqueda.nombre",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "columnas", "min": 2, "max": 6, "step": 1, "label": "t:comun.columnas", "default": 4 },
    { "type": "range", "id": "columnas_movil", "min": 1, "max": 2, "step": 1, "label": "t:comun.columnas_movil", "default": 2 },
    { "type": "range", "id": "por_pagina", "min": 8, "max": 48, "step": 4, "label": "t:secciones.coleccion.por_pagina", "default": 24 },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:comun.ratio",
      "default": "1/1",
      "options": [
        { "value": "1/1", "label": "t:comun.ratios.cuadrada" },
        { "value": "4/5", "label": "t:comun.ratios.vertical" },
        { "value": "3/4", "label": "t:comun.ratios.retrato" }
      ]
    }
  ]
}
{% endschema %}
