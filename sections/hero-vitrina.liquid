{%- comment -%}
  Hero «vitrina»: foto a sangre, titular partido en dos colores y una tira de
  producto abajo.

  El truco del titular: se imprime DOS veces, superpuesto, y cada copia se
  recorta con `clip-path` justo por la línea donde cambia el fondo. La copia
  de la izquierda va en claro (sobre la foto), la de la derecha en tinta
  (sobre el panel claro). Como el corte es el mismo para el fondo y para el
  texto, una misma palabra puede quedar mitad clara y mitad oscura.

  Sólo hay UNA copia legible para lectores de pantalla; la otra va con
  aria-hidden para que el titular no se lea dos veces.
{%- endcomment -%}

{%- liquid
  assign coleccion = section.settings.coleccion

  comment
    Solo la PRIMERA seccion de la pagina puede llevar <h1>. Si se ponen dos
    heroes (pasa mientras se decide cual queda), el segundo baja a <h2>: el
    tamano lo pone la clase, no la etiqueta, asi que no cambia nada de aspecto.
  endcomment
  assign etiqueta_titular = 'h2'
  if section.index == 1
    assign etiqueta_titular = 'h1'
  endif
  assign cuantos = coleccion.products_count | default: 0 | plus: 0
  assign corte = section.settings.corte | default: 50

  assign t1 = section.settings.titulo_1
  if t1 == blank
    assign t1 = 'secciones.vitrina.titulo_1' | t
  endif
  assign t2 = section.settings.titulo_2
  if t2 == blank
    assign t2 = 'secciones.vitrina.titulo_2' | t
  endif
  assign sub = section.settings.subtitulo
  if sub == blank
    assign sub = 'secciones.vitrina.subtitulo' | t
  endif
-%}

<section class="vitrina vitrina--{{ section.settings.altura }}"
  style="--corte: {{ corte }}%; --vel-fondo: {{ section.settings.zoom }};">

  <div class="vitrina__fondo" aria-hidden="true">
    {%- if section.settings.imagen != blank -%}
      <img src="{{ section.settings.imagen | image_url: width: 2200 }}"
        srcset="{{ section.settings.imagen | image_url: width: 900 }} 900w,
                {{ section.settings.imagen | image_url: width: 1400 }} 1400w,
                {{ section.settings.imagen | image_url: width: 2200 }} 2200w"
        sizes="100vw" alt="" width="{{ section.settings.imagen.width }}"
        height="{{ section.settings.imagen.height }}" loading="eager" fetchpriority="high">
    {%- else -%}
      <span class="vitrina__marcador"></span>
    {%- endif -%}
    <span class="vitrina__velo" style="opacity: {{ section.settings.velo | divided_by: 100.0 }};"></span>
  </div>

  <div class="vitrina__panel" aria-hidden="true"></div>

  <div class="vitrina__ui">
    {%- comment -%}
      Todo el texto se parte por la misma línea, no sólo el titular: si el
      antetítulo o el subtítulo fueran de un solo color, la mitad que cae
      sobre la foto oscura no se leería.
    {%- endcomment -%}

    {%- if section.settings.eyebrow != blank -%}
      {%- capture eyebrow_html -%}
        <span class="dot" aria-hidden="true"></span> {{ section.settings.eyebrow }}
      {%- endcapture -%}
      <div class="vitrina__fila" data-hero-in>
        {% render 'texto-partido', etiqueta: 'p', clase: 'eyebrow vitrina__eyebrow', contenido: eyebrow_html %}
      </div>
    {%- endif -%}

    {%- capture titulo_html -%}
      <span class="vitrina__l">{{ t1 }}</span>
      {%- if t2 != blank %}<span class="vitrina__l">{{ t2 }}</span>{% endif -%}
    {%- endcapture -%}
    <div class="vitrina__fila" data-hero-in>
      {% render 'texto-partido', etiqueta: etiqueta_titular, clase: 'vitrina__h1', contenido: titulo_html %}
    </div>

    {%- if sub != blank -%}
      <div class="vitrina__fila" data-hero-in>
        {% render 'texto-partido', etiqueta: 'p', clase: 'vitrina__sub', contenido: sub %}
      </div>
    {%- endif -%}

    <div class="vitrina__cta" data-hero-in>
      {%- if section.settings.cta_texto != blank -%}
        <a class="btn btn--ink btn--lg" href="{{ section.settings.cta_url | default: '#estanteria' }}">
          {{ section.settings.cta_texto }}
          {% render 'icono', tipo: 'flecha' %}
        </a>
      {%- endif -%}
      {%- if section.settings.cta2_texto != blank -%}
        {%- if section.settings.cta2_chat -%}
          <button class="btn btn--ghost btn--lg" type="button" data-chat>
            {% render 'icono', tipo: 'chat', tam: 16 %}
            {{ section.settings.cta2_texto }}
          </button>
        {%- else -%}
          <a class="btn btn--ghost btn--lg" href="{{ section.settings.cta2_url | default: '#ritual' }}">
            {{ section.settings.cta2_texto }}
          </a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.mostrar_tira -%}
    <div class="vitrina__tira" data-hero-in>
      {%- if section.settings.tira_titulo != blank -%}
        <p class="vitrina__tira-tit">{{ section.settings.tira_titulo }}</p>
      {%- endif -%}

      {%- if cuantos > 0 -%}
        <div class="carrusel carrusel--mini" data-carrusel>
          <ul class="carrusel__pista" data-carrusel-pista tabindex="0" role="region"
            aria-label="{{ 'secciones.carrusel.aria' | t }}">
            {%- for producto in coleccion.products limit: section.settings.tira_limite -%}
              <li class="carrusel__slide">{% render 'card-mini', producto: producto %}</li>
            {%- endfor -%}
          </ul>
          <div class="carrusel__mandos carrusel__mandos--lados">
            <button class="carrusel__flecha" type="button" data-carrusel-paso="-1"
              aria-label="{{ 'general.accesibilidad.anterior' | t }}">
              {% render 'icono', tipo: 'izquierda', tam: 18, grosor: 2 %}
            </button>
            <button class="carrusel__flecha" type="button" data-carrusel-paso="1"
              aria-label="{{ 'general.accesibilidad.siguiente' | t }}">
              {% render 'icono', tipo: 'derecha', tam: 18, grosor: 2 %}
            </button>
          </div>
        </div>
      {%- else -%}
        <ul class="carrusel__pista carrusel__pista--vacia" aria-hidden="true">
          {%- for i in (1..5) -%}
            <li class="carrusel__slide"><span class="mini mini--vacia"><span class="mini__shot"><span class="card__sinfoto"></span></span><span class="mini__nombre">&mdash;</span></span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:secciones.vitrina.nombre",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "imagen", "label": "t:secciones.vitrina.imagen", "info": "t:secciones.vitrina.imagen_info" },
    {
      "type": "select",
      "id": "altura",
      "label": "t:comun.altura",
      "default": "pantalla",
      "options": [
        { "value": "media", "label": "t:comun.alturas.media" },
        { "value": "alta", "label": "t:comun.alturas.alta" },
        { "value": "pantalla", "label": "t:comun.alturas.pantalla" }
      ]
    },
    { "type": "range", "id": "corte", "min": 20, "max": 80, "step": 5, "unit": "%", "label": "t:secciones.vitrina.corte", "info": "t:secciones.vitrina.corte_info", "default": 50 },
    { "type": "range", "id": "velo", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "t:secciones.vitrina.velo", "default": 30 },
    { "type": "range", "id": "zoom", "min": 100, "max": 120, "step": 2, "unit": "%", "label": "t:secciones.vitrina.zoom", "default": 106 },
    { "type": "header", "content": "t:comun.textos" },
    { "type": "paragraph", "content": "t:comun.vacio_traduce" },
    { "type": "text", "id": "eyebrow", "label": "t:comun.antetitulo", "default": "Decants y frascos originales · Toda Venezuela" },
    { "type": "text", "id": "titulo_1", "label": "t:comun.titular_1" },
    { "type": "text", "id": "titulo_2", "label": "t:comun.titular_2" },
    { "type": "textarea", "id": "subtitulo", "label": "t:comun.subtitulo" },
    { "type": "text", "id": "cta_texto", "label": "t:comun.boton", "default": "Ver los decants" },
    { "type": "url", "id": "cta_url", "label": "t:comun.boton_enlace" },
    { "type": "text", "id": "cta2_texto", "label": "t:comun.boton_2", "default": "Cómo funciona" },
    { "type": "url", "id": "cta2_url", "label": "t:comun.boton_2_enlace" },
    { "type": "checkbox", "id": "cta2_chat", "label": "t:comun.boton_2_chat", "default": false },
    { "type": "header", "content": "t:secciones.vitrina.tira" },
    { "type": "checkbox", "id": "mostrar_tira", "label": "t:secciones.vitrina.mostrar_tira", "default": true },
    { "type": "collection", "id": "coleccion", "label": "t:comun.coleccion" },
    { "type": "text", "id": "tira_titulo", "label": "t:comun.antetitulo", "default": "Los que más nos piden" },
    { "type": "range", "id": "tira_limite", "min": 3, "max": 16, "step": 1, "label": "t:secciones.carrusel.limite", "default": 8 }
  ],
  "presets": [
    {
      "name": "t:secciones.vitrina.presets.vitrina",
      "settings": { "altura": "pantalla", "corte": 50, "velo": 30, "mostrar_tira": true }
    },
    {
      "name": "t:secciones.vitrina.presets.editorial",
      "settings": { "altura": "alta", "corte": 65, "velo": 15, "zoom": 100, "mostrar_tira": false, "cta2_texto": "" }
    },
    {
      "name": "t:secciones.vitrina.presets.campana",
      "settings": { "altura": "pantalla", "corte": 30, "velo": 45, "zoom": 112, "mostrar_tira": true, "tira_titulo": "De la campaña" }
    },
    {
      "name": "t:secciones.vitrina.presets.franja",
      "settings": { "altura": "media", "corte": 50, "velo": 25, "mostrar_tira": false, "eyebrow": "" }
    },
    {
      "name": "t:secciones.vitrina.presets.chat",
      "settings": { "altura": "alta", "corte": 55, "velo": 35, "mostrar_tira": true, "cta_texto": "Ver los decants", "cta2_texto": "Pregúntanos por el chat", "cta2_chat": true }
    }
  ]
}
{% endschema %}
