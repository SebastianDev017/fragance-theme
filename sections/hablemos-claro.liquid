{%- comment -%}
  Preguntas honestas. Cada una es un bloque.

  El <details> es nativo: se abre y se cierra sin JavaScript, y el buscador lo
  indexa igual. Un bloque en blanco cae en la pregunta traducida que
  corresponde a su posición.
{%- endcomment -%}

{%- liquid
  assign titulo = section.settings.titulo
  if titulo == blank
    assign titulo = 'secciones.claro.titulo' | t
  endif
-%}

<section class="claro claro--{{ section.settings.disposicion }}" id="{{ section.settings.ancla | default: 'claro' }}">
  <header class="sec-head{% if section.settings.disposicion == 'centrada' %} sec-head--center{% endif %}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span> {{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="h2">{{ titulo }}</h2>
    {%- if section.settings.texto != blank -%}
      <p class="sec-head__p">{{ section.settings.texto }}</p>
    {%- endif -%}
  </header>

  <div class="qa">
    {%- for block in section.blocks -%}
      {%- liquid
        assign i = forloop.index
        assign p = block.settings.pregunta
        if p == blank
          assign clave = 'secciones.claro.preguntas.' | append: i | append: '.p'
          assign p = clave | t
        endif
        assign r = block.settings.respuesta
        if r == blank
          assign clave = 'secciones.claro.preguntas.' | append: i | append: '.r'
          assign r = clave | t
        endif
      -%}
      <details class="qa__item"
        {% if section.settings.primera_abierta and forloop.first %}open{% endif %}
        {{ block.shopify_attributes }}>
        <summary><span>{{ p }}</span><i aria-hidden="true"></i></summary>
        <div class="qa__cuerpo">
          <p>{{ r }}</p>
          {%- if block.settings.cta_chat != blank -%}
            <button class="link" type="button" data-chat>{{ block.settings.cta_chat }}</button>
          {%- endif -%}
        </div>
      </details>
    {%- endfor -%}
  </div>

  {%- if section.settings.pie != blank -%}
    <p class="claro__pie">
      {{ section.settings.pie }}
      <button class="link" type="button" data-chat>{{ section.settings.pie_enlace }}</button>
    </p>
  {%- endif -%}
</section>

{%- comment -%}
  Las mismas preguntas, en `FAQPage`.

  Va aquí y no en snippets/seo.liquid porque el dato tiene que salir de los
  bloques REALES de esta sección: si el comerciante cambia una respuesta en el
  editor, cambia también lo que lee el buscador. Un `FAQPage` escrito a mano en
  otro archivo se desincroniza el primer día.

  Esto es lo que más peso tiene para los buscadores que contestan en prosa: una
  pregunta escrita como pregunta, con su respuesta completa al lado, es
  exactamente la forma que citan.

  `strip_html` porque la respuesta puede traer marcado del editor y el JSON-LD
  de una FAQ admite texto, no un párrafo con etiquetas sueltas.
{%- endcomment -%}
{%- if section.settings.datos_buscadores and section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {%- liquid
          assign i = forloop.index
          assign p = block.settings.pregunta
          if p == blank
            assign clave = 'secciones.claro.preguntas.' | append: i | append: '.p'
            assign p = clave | t
          endif
          assign r = block.settings.respuesta
          if r == blank
            assign clave = 'secciones.claro.preguntas.' | append: i | append: '.r'
            assign r = clave | t
          endif
        -%}
        {
          "@type": "Question",
          "name": {{ p | strip_html | strip | json }},
          "acceptedAnswer": { "@type": "Answer", "text": {{ r | strip_html | strip | json }} }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:secciones.claro.nombre",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "disposicion",
      "label": "t:comun.disposicion",
      "default": "ancha",
      "options": [
        { "value": "ancha", "label": "t:secciones.claro.disposiciones.ancha" },
        { "value": "dos", "label": "t:secciones.claro.disposiciones.dos" },
        { "value": "centrada", "label": "t:secciones.claro.disposiciones.centrada" }
      ]
    },
    {
      "type": "checkbox",
      "id": "datos_buscadores",
      "label": "t:secciones.claro.datos",
      "info": "t:secciones.claro.datos_info",
      "default": true
    },
    { "type": "checkbox", "id": "primera_abierta", "label": "t:secciones.claro.primera_abierta", "default": true },
    { "type": "header", "content": "t:comun.textos" },
    { "type": "paragraph", "content": "t:comun.vacio_traduce" },
    { "type": "text", "id": "eyebrow", "label": "t:comun.antetitulo" },
    { "type": "text", "id": "titulo", "label": "t:comun.titular" },
    { "type": "textarea", "id": "texto", "label": "t:comun.texto" },
    { "type": "text", "id": "pie", "label": "t:secciones.claro.pie", "default": "¿Te queda una duda que no está aquí?" },
    { "type": "text", "id": "pie_enlace", "label": "t:secciones.claro.pie_enlace", "default": "Escríbenos por el chat" },
    { "type": "text", "id": "ancla", "label": "t:comun.ancla", "default": "claro" }
  ],
  "blocks": [
    {
      "type": "pregunta",
      "name": "t:secciones.claro.bloque",
      "settings": [
        { "type": "text", "id": "pregunta", "label": "t:secciones.claro.pregunta" },
        { "type": "textarea", "id": "respuesta", "label": "t:secciones.claro.respuesta" },
        { "type": "text", "id": "cta_chat", "label": "t:secciones.claro.cta_chat", "info": "t:secciones.claro.cta_chat_info" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:secciones.claro.presets.completa",
      "settings": { "disposicion": "ancha" },
      "blocks": [
        { "type": "pregunta" }, { "type": "pregunta" }, { "type": "pregunta" },
        { "type": "pregunta" }, { "type": "pregunta" }
      ]
    },
    {
      "name": "t:secciones.claro.presets.dos_columnas",
      "settings": { "disposicion": "dos", "primera_abierta": false },
      "blocks": [
        { "type": "pregunta" }, { "type": "pregunta" }, { "type": "pregunta" },
        { "type": "pregunta" }, { "type": "pregunta" }
      ]
    },
    {
      "name": "t:secciones.claro.presets.corta",
      "settings": { "disposicion": "centrada", "texto": "", "pie": "" },
      "blocks": [{ "type": "pregunta" }, { "type": "pregunta" }, { "type": "pregunta" }]
    },
    {
      "name": "t:secciones.claro.presets.envios",
      "settings": { "disposicion": "ancha", "primera_abierta": true },
      "blocks": [
        { "type": "pregunta", "settings": { "cta_chat": "Coordinar por el chat" } },
        { "type": "pregunta" },
        { "type": "pregunta" }
      ]
    },
    {
      "name": "t:secciones.claro.presets.confianza",
      "settings": { "disposicion": "dos", "pie": "¿Sigues con dudas?" },
      "blocks": [{ "type": "pregunta" }, { "type": "pregunta" }]
    }
  ]
}
{% endschema %}
