{%- comment -%}
  El catálogo, en rejilla.

  Lee una colección: no hay lista de productos escrita a mano en ningún sitio,
  así que lo que esté publicado en Shopify es lo que se ve.

  Cuántos productos salen NO se pide aparte: es filas × columnas, para que lo
  que el comerciante ve en el editor sea exactamente lo que sale en la tienda
  y no queden huecos a media fila.
{%- endcomment -%}

{%- liquid
  comment
    Un ajuste de tipo `collection` devuelve el OBJETO, no el handle: hacer
    collections[ajuste] da basura. Y `products_count` de una colección vacía o
    sin elegir es nil, así que hay que forzarlo a número antes de comparar
    (Liquid evalúa las condiciones de derecha a izquierda, así que un
    `if coleccion != blank and coleccion.products_count > 0` reventaría igual).
  endcomment
  assign coleccion = section.settings.coleccion
  assign cuantos = coleccion.products_count | default: 0 | plus: 0

  assign cols = section.settings.columnas | default: 4
  assign cols_movil = section.settings.columnas_movil | default: 1
  assign filas = section.settings.filas | default: 2
  assign limite = cols | times: filas

  assign titulo = section.settings.titulo
  if titulo == blank
    assign titulo = 'secciones.estanteria.titulo' | t
  endif
-%}

<section class="estanteria" id="{{ section.settings.ancla | default: 'estanteria' }}"
  style="--cols: {{ cols }}; --cols-movil: {{ cols_movil }};">

  <header class="sec-head sec-head--row">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow"><span class="dot" aria-hidden="true"></span> {{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="h2">{{ titulo }}</h2>
    </div>
    {%- if section.settings.texto != blank -%}
      <p class="sec-head__p">{{ section.settings.texto }}</p>
    {%- endif -%}
  </header>

  {%- if cuantos > 0 -%}
    <div class="shelf">
      {%- for producto in coleccion.products limit: limite -%}
        {% render 'card-fragancia', producto: producto, ratio: section.settings.ratio %}
      {%- endfor -%}
    </div>

    {%- if section.settings.ver_todo != blank and cuantos > limite -%}
      <p class="estanteria__mas">
        <a class="btn btn--ghost" href="{{ coleccion.url }}">
          {{ section.settings.ver_todo }}
          {% render 'icono', tipo: 'flecha', tam: 17 %}
        </a>
      </p>
    {%- endif -%}
  {%- else -%}
    {%- comment -%}
      Sin colección (o vacía) la sección muestra tarjetas de marcador: se
      entiende que falta contenido, no que el tema esté roto.
    {%- endcomment -%}
    <div class="shelf shelf--vacia" aria-hidden="true">
      {%- for i in (1..cols) -%}
        {% render 'card-vacia', ratio: section.settings.ratio %}
      {%- endfor -%}
    </div>
    <p class="aviso-vacio">
      {%- if coleccion == blank -%}
        {{ 'general.vacio.elige_coleccion' | t }}
      {%- else -%}
        {{ 'general.vacio.coleccion_sin_productos' | t: titulo: coleccion.title }}
      {%- endif -%}
    </p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:secciones.estanteria.nombre",
  "tag": "div",
  "settings": [
    { "type": "collection", "id": "coleccion", "label": "t:comun.coleccion" },
    { "type": "header", "content": "t:comun.rejilla" },
    { "type": "range", "id": "columnas", "min": 2, "max": 6, "step": 1, "label": "t:comun.columnas", "default": 4 },
    { "type": "range", "id": "filas", "min": 1, "max": 8, "step": 1, "label": "t:comun.filas", "default": 2 },
    { "type": "range", "id": "columnas_movil", "min": 1, "max": 3, "step": 1, "label": "t:comun.columnas_movil", "default": 1 },
    {
      "type": "select",
      "id": "ratio",
      "label": "t:comun.ratio",
      "info": "t:comun.ratio_info",
      "default": "1/1",
      "options": [
        { "value": "1/1", "label": "t:comun.ratios.cuadrada" },
        { "value": "4/5", "label": "t:comun.ratios.vertical" },
        { "value": "3/4", "label": "t:comun.ratios.retrato" },
        { "value": "5/4", "label": "t:comun.ratios.horizontal" },
        { "value": "16/9", "label": "t:comun.ratios.panoramica" }
      ]
    },
    { "type": "header", "content": "t:comun.textos" },
    { "type": "paragraph", "content": "t:comun.vacio_traduce" },
    { "type": "text", "id": "eyebrow", "label": "t:comun.antetitulo" },
    { "type": "text", "id": "titulo", "label": "t:comun.titular" },
    { "type": "textarea", "id": "texto", "label": "t:comun.texto" },
    { "type": "text", "id": "ver_todo", "label": "t:secciones.estanteria.ver_todo", "default": "Ver el catálogo completo" },
    { "type": "text", "id": "ancla", "label": "t:comun.ancla", "default": "estanteria" }
  ],
  "presets": [
    {
      "name": "t:secciones.estanteria.presets.estanteria",
      "settings": { "columnas": 4, "filas": 2, "columnas_movil": 1, "ratio": "1/1", "texto": "Nada raro, nada de nicho imposible de conseguir. Los que reconoces cuando pasan por al lado — y algunos que deberías conocer." }
    },
    {
      "name": "t:secciones.estanteria.presets.destacados",
      "settings": { "columnas": 3, "filas": 1, "columnas_movil": 1, "ratio": "4/5", "ver_todo": "" }
    },
    {
      "name": "t:secciones.estanteria.presets.muro",
      "settings": { "columnas": 6, "filas": 3, "columnas_movil": 2, "ratio": "1/1", "ver_todo": "" }
    },
    {
      "name": "t:secciones.estanteria.presets.duo",
      "settings": { "columnas": 2, "filas": 1, "columnas_movil": 1, "ratio": "5/4", "ver_todo": "" }
    },
    {
      "name": "t:secciones.estanteria.presets.compacta",
      "settings": { "columnas": 5, "filas": 1, "columnas_movil": 2, "ratio": "3/4", "ver_todo": "" }
    }
  ]
}
{% endschema %}
