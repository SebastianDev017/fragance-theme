{%- comment -%}
  Mensajes reales de clientes, con forma de chat. Cada burbuja es un bloque:
  «recibido» es del cliente y «enviado» es la respuesta de la tienda.

  Es la prueba social de una tienda que vende POR chat: enseñarla como
  testimonios con estrellas sonaría a otra tienda distinta.
{%- endcomment -%}

{%- liquid
  assign titulo = section.settings.titulo
  if titulo == blank
    assign titulo = 'secciones.voces.titulo' | t
  endif
-%}

<section class="voces voces--{{ section.settings.ancho }}" id="{{ section.settings.ancla | default: 'voces' }}">
  <header class="sec-head{% if section.settings.alinear == 'centro' %} sec-head--center{% endif %}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span> {{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="h2">{{ titulo }}</h2>
    {%- if section.settings.texto != blank -%}
      <p class="sec-head__p">{{ section.settings.texto }}</p>
    {%- endif -%}
  </header>

  <div class="chat">
    {%- for block in section.blocks -%}
      {%- liquid
        assign i = forloop.index
        assign msg = block.settings.texto
        if msg == blank
          assign clave = 'secciones.voces.mensajes.' | append: i
          assign msg = clave | t
        endif
        assign ancha = ''
        if msg.size > 90
          assign ancha = ' bubble--wide'
        endif
      -%}
      <div class="bubble bubble--{% if block.type == 'enviado' %}out{% else %}in{% endif %}{{ ancha }}" {{ block.shopify_attributes }}>
        <p>{{ msg }}</p>
        {%- if block.settings.hora != blank -%}<time>{{ block.settings.hora }}</time>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.cta != blank -%}
    <p class="voces__cta">
      <button class="btn btn--ghost" type="button" data-chat>
        {% render 'icono', tipo: 'chat', tam: 16 %}
        {{ section.settings.cta }}
      </button>
    </p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:secciones.voces.nombre",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "ancho",
      "label": "t:comun.ancho",
      "default": "angosto",
      "options": [
        { "value": "angosto", "label": "t:secciones.voces.anchos.angosto" },
        { "value": "medio", "label": "t:secciones.voces.anchos.medio" },
        { "value": "ancho", "label": "t:secciones.voces.anchos.ancho" }
      ]
    },
    {
      "type": "select",
      "id": "alinear",
      "label": "t:comun.alineacion",
      "default": "centro",
      "options": [
        { "value": "izquierda", "label": "t:comun.alineaciones.izquierda" },
        { "value": "centro", "label": "t:comun.alineaciones.centro" }
      ]
    },
    { "type": "header", "content": "t:comun.textos" },
    { "type": "paragraph", "content": "t:comun.vacio_traduce" },
    { "type": "text", "id": "eyebrow", "label": "t:comun.antetitulo", "default": "Lo que nos escriben" },
    { "type": "text", "id": "titulo", "label": "t:comun.titular" },
    { "type": "textarea", "id": "texto", "label": "t:comun.texto" },
    { "type": "text", "id": "cta", "label": "t:secciones.voces.cta" },
    { "type": "text", "id": "ancla", "label": "t:comun.ancla", "default": "voces" }
  ],
  "blocks": [
    {
      "type": "recibido",
      "name": "t:secciones.voces.bloque_cliente",
      "settings": [
        { "type": "textarea", "id": "texto", "label": "t:secciones.voces.mensaje" },
        { "type": "text", "id": "hora", "label": "t:secciones.voces.hora", "default": "10:42" }
      ]
    },
    {
      "type": "enviado",
      "name": "t:secciones.voces.bloque_tienda",
      "settings": [
        { "type": "textarea", "id": "texto", "label": "t:secciones.voces.mensaje" },
        { "type": "text", "id": "hora", "label": "t:secciones.voces.hora", "default": "10:44" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:secciones.voces.presets.conversacion",
      "settings": { "ancho": "angosto", "alinear": "centro" },
      "blocks": [
        { "type": "recibido", "settings": { "hora": "10:42" } },
        { "type": "enviado", "settings": { "hora": "10:44" } },
        { "type": "recibido", "settings": { "hora": "18:07" } },
        { "type": "recibido", "settings": { "hora": "21:15" } },
        { "type": "enviado", "settings": { "hora": "21:16" } }
      ]
    },
    {
      "name": "t:secciones.voces.presets.corta",
      "settings": { "ancho": "angosto", "alinear": "centro", "texto": "" },
      "blocks": [
        { "type": "recibido", "settings": { "hora": "10:42" } },
        { "type": "enviado", "settings": { "hora": "10:44" } }
      ]
    },
    {
      "name": "t:secciones.voces.presets.muro",
      "settings": { "ancho": "ancho", "alinear": "centro" },
      "blocks": [
        { "type": "recibido", "settings": { "hora": "09:10" } },
        { "type": "recibido", "settings": { "hora": "12:31" } },
        { "type": "recibido", "settings": { "hora": "18:07" } },
        { "type": "recibido", "settings": { "hora": "21:15" } }
      ]
    },
    {
      "name": "t:secciones.voces.presets.con_cta",
      "settings": { "ancho": "medio", "alinear": "centro", "cta": "Escríbenos tú también" },
      "blocks": [
        { "type": "recibido", "settings": { "hora": "10:42" } },
        { "type": "enviado", "settings": { "hora": "10:44" } },
        { "type": "recibido", "settings": { "hora": "18:07" } }
      ]
    },
    {
      "name": "t:secciones.voces.presets.izquierda",
      "settings": { "ancho": "medio", "alinear": "izquierda", "eyebrow": "Sin filtro" },
      "blocks": [
        { "type": "recibido", "settings": { "hora": "10:42" } },
        { "type": "enviado", "settings": { "hora": "10:44" } },
        { "type": "recibido", "settings": { "hora": "21:15" } }
      ]
    }
  ]
}
{% endschema %}
