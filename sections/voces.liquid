{%- comment -%}
  Mensajes reales de clientes, con forma de chat. Cada burbuja es un bloque:
  "recibido" es del cliente y "enviado" es la respuesta de la tienda.
{%- endcomment -%}

<section class="voces" id="{{ section.settings.ancla | default: 'voces' }}">
  <header class="sec-head sec-head--center">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span> {{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="h2">{{ section.settings.titulo }}</h2>
  </header>

  <div class="chat">
    {%- for block in section.blocks -%}
      {%- liquid
        assign ancha = ''
        if block.settings.texto.size > 90
          assign ancha = ' bubble--wide'
        endif
      -%}
      <div class="bubble bubble--{% if block.type == 'enviado' %}out{% else %}in{% endif %}{{ ancha }}" {{ block.shopify_attributes }}>
        <p>{{ block.settings.texto }}</p>
        {%- if block.settings.hora != blank -%}<time>{{ block.settings.hora }}</time>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Voces",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetitulo", "default": "Lo que nos escriben" },
    { "type": "text", "id": "titulo", "label": "Titular", "default": "Sin filtro." },
    { "type": "text", "id": "ancla", "label": "Ancla", "default": "voces" }
  ],
  "blocks": [
    {
      "type": "recibido",
      "name": "Mensaje del cliente",
      "settings": [
        { "type": "textarea", "id": "texto", "label": "Mensaje" },
        { "type": "text", "id": "hora", "label": "Hora", "default": "10:42" }
      ]
    },
    {
      "type": "enviado",
      "name": "Respuesta de la tienda",
      "settings": [
        { "type": "textarea", "id": "texto", "label": "Mensaje" },
        { "type": "text", "id": "hora", "label": "Hora", "default": "10:44" }
      ]
    }
  ],
  "presets": [{ "name": "Voces" }]
}
{% endschema %}
