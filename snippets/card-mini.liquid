{%- comment -%}
  Tarjeta compacta: foto, nombre y precio de entrada. Nada más.

  Se usa en las tiras de producto de los heroes, donde la tarjeta grande del
  catálogo robaría todo el protagonismo al titular.

  Uso: {% render 'card-mini', producto: producto %}
{%- endcomment -%}

{%- liquid
  assign v_entrada = null
  for v in producto.variants
    if v.title contains 'Decant 5'
      assign v_entrada = v
      break
    endif
  endfor
  unless v_entrada
    assign v_entrada = producto.selected_or_first_available_variant
  endunless
-%}

<a class="mini" href="{{ producto.url }}">
  <span class="mini__shot">
    {%- if producto.featured_image -%}
      <img src="{{ producto.featured_image | image_url: width: 500 }}"
        srcset="{{ producto.featured_image | image_url: width: 300 }} 300w,
                {{ producto.featured_image | image_url: width: 500 }} 500w,
                {{ producto.featured_image | image_url: width: 750 }} 750w"
        sizes="(min-width: 750px) 200px, 45vw"
        alt="{{ producto.featured_image.alt | default: producto.title | escape }}"
        width="{{ producto.featured_image.width }}" height="{{ producto.featured_image.height }}"
        loading="lazy" decoding="async">
    {%- else -%}
      <span class="card__sinfoto" aria-hidden="true"></span>
    {%- endif -%}
  </span>
  <span class="mini__nombre">{{ producto.title }}</span>
  <span class="mini__precio">{{ v_entrada.price | money }}</span>
</a>
