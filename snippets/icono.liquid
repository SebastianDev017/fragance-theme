{%- comment -%}
  Todos los iconos del tema en un solo sitio.

  Uso: {% render 'icono', tipo: 'carrito' %}
       {% render 'icono', tipo: 'flecha', tam: 22 %}

  Van con `currentColor` y sin `title`: son decorativos, la etiqueta la pone
  siempre el botón o el enlace que los envuelve.
{%- endcomment -%}

{%- liquid
  assign tam = tam | default: 18
  assign grosor = grosor | default: 1.8
-%}

<svg class="ico ico--{{ tipo }}" viewBox="0 0 24 24" width="{{ tam }}" height="{{ tam }}"
  fill="none" stroke="currentColor" stroke-width="{{ grosor }}" stroke-linecap="round"
  stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case tipo -%}
    {%- when 'flecha' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'izquierda' -%}<path d="M15 5l-7 7 7 7"/>
    {%- when 'derecha' -%}<path d="M9 5l7 7-7 7"/>
    {%- when 'abajo' -%}<path d="M12 5v14M6 13l6 6 6-6"/>
    {%- when 'chat' -%}<path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.3-.6L3 21l1.8-5.1A8.2 8.2 0 0 1 4 11.5 8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5Z"/>
    {%- when 'menu' -%}<path d="M3 6h18M3 12h18M3 18h18"/>
    {%- when 'cerrar' -%}<path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'buscar' -%}<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/>
    {%- when 'cuenta' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
    {%- when 'carrito' -%}<path d="M7 8h10l1.4 11.2a1.5 1.5 0 0 1-1.5 1.8H7.1a1.5 1.5 0 0 1-1.5-1.8L7 8Z"/><path d="M9.2 10V6.6a2.8 2.8 0 0 1 5.6 0V10"/>
    {%- when 'globo' -%}<circle cx="12" cy="12" r="9"/><path d="M3.5 9h17M3.5 15h17"/><path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z"/>
    {%- when 'gota' -%}<path d="M12 3c3 4.6 6 8.2 6 11.2a6 6 0 0 1-12 0C6 11.2 9 7.6 12 3Z"/>
    {%- when 'menos' -%}<path d="M5 12h14"/>
    {%- when 'mas' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'papelera' -%}<path d="M4 7h16M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7M6.5 7l.8 12.1A1.5 1.5 0 0 0 8.8 20.5h6.4a1.5 1.5 0 0 0 1.5-1.4L17.5 7"/>
    {%- when 'check' -%}<path d="M4.5 12.5l5 5 10-11"/>
    {%- when 'camion' -%}<path d="M2 7h11v10H2zM13 10h4l4 3.4V17h-8"/><circle cx="6.5" cy="18.5" r="1.8"/><circle cx="17" cy="18.5" r="1.8"/>
    {%- when 'filtro' -%}<path d="M3 6h18M6 12h12M10 18h4"/>
    {%- when 'rejilla' -%}<rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/>
    {%- when 'escudo' -%}<path d="M12 3l7.5 3v5.5c0 4.6-3.1 8.3-7.5 9.5-4.4-1.2-7.5-4.9-7.5-9.5V6L12 3Z"/><path d="M9 12l2 2 4-4.5"/>
  {%- endcase -%}
</svg>
